# 이 파일을 복사해 .env 로 만들고 값을 채운다. .env 는 저장소에 올라가지 않는다.

# DART OpenAPI 인증키 (https://opendart.fss.or.kr 무료 발급)
DART_API_KEY=

# 한국은행 ECOS 인증키 (https://ecos.bok.or.kr 무료 발급) — 업황 지표용
ECOS_API_KEY=

# @BotFather 에서 /newbot 으로 만든 봇의 토큰
TELEGRAM_BOT_TOKEN=

# 채널이면 @채널이름, 개인 채팅이면 숫자.  python -m bot.whoami 로 확인
TELEGRAM_CHAT_ID=

# (선택) 기사 '내용 요약·분석'을 쓰는 AI 키. 둘 다 없으면 분석 대신 키워드와 관련 종목만 보여준다.
# Google Gemini — 무료 등급으로 충분하다. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude (유료). Gemini 키가 없을 때만 쓴다. https://console.anthropic.com
ANTHROPIC_API_KEY=
